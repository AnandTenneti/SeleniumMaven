pipeline {
    agent any

    tools {
        maven 'MAVEN_HOME'   // Must match your Jenkins Maven installation name
        jdk 'JAVA_HOME'          // Must match your Jenkins JDK installation name
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                url: 'https://github.com/AnandTenneti/SeleniumMaven.git'
            }
        }

        stage('Build & Run Tests') {
            steps {
                sh 'mvn clean test'
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
